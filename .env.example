# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.

# --- Growth Studio funding tool (/growth-studio/funding) ---
# Without these, the site still runs; only the funding tool's API routes
# respond "not configured". On Vercel, set the same three under
# Settings → Environment Variables (Production + Preview).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

# --- Website analytics (PostHog EU Cloud, cookieless) ---
# Public project key (phc_...), safe to ship to browsers. Only production builds
# send events. On Vercel, set it for Production only so previews stay untracked.
NEXT_PUBLIC_POSTHOG_KEY=

# --- Website analytics tab in the funding admin (PostHog project secret key, phs_...) ---
# Server-only, never prefix with NEXT_PUBLIC_. Only needs the endpoint:read scope.
# Set it on Vercel for Production + Preview. See docs/funding-tool/SETUP.md, Part 6.
POSTHOG_SECRET_KEY=
